{
  "manifest_version": 3,
  "name": "KannadaWords Writing Assistant",
  "version": "0.2.1",
  "description": "Local word-level Kannada suggestions plus optional selected-passage rewriting.",
  "permissions": [],
  "host_permissions": [
    "https://kannadawords-ai.tulasianand6.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KannadaWords Writing Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vocabulary.js",
        "content.js",
        "word-assistant.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
