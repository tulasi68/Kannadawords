{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KannadaWords source reference registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "references"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "dictionary",
              "corpus",
              "inscription",
              "publication",
              "website",
              "contributor",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "string"
            ]
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "locator": {
            "type": "string"
          },
          "accessedAt": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}