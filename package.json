{
  "name": "kannadawords",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "lexicon:validate": "node scripts/validate-lexicon.mjs",
    "lexicon:build": "node scripts/build-lexicon.mjs",
    "lexicon:check": "node scripts/build-lexicon.mjs --check",
    "test": "node --test",
    "lexicon:schema": "npx --yes ajv-cli@5.0.0 validate -s lexicon-source/schema/lexicon.schema.json -d 'lexicon-source/entries/*.json' --spec=draft2020 && npx --yes ajv-cli@5.0.0 validate -s lexicon-source/schema/references.schema.json -d lexicon-source/references.json --spec=draft2020",
    "lexicon:migration-check": "node scripts/migrate-legacy-v1.mjs --check",
    "lexicon:find": "node scripts/find-entry.mjs",
    "lexicon:coverage": "node scripts/check-contributor-coverage.mjs",
    "textbook:import": "node scripts/import-textbook-words.mjs",
    "vocabulary:build": "node scripts/build-master-vocabulary.mjs",
    "vocabulary:check": "node scripts/build-master-vocabulary.mjs --check"
  }
}
